+test_that("ownership probe detects direct assay reads and removes tracing after failure", {
+    harness <- new.env(parent = baseenv())
+    sys.source(test_path("..", "..", "tools/profiling/workflow_checkpoint_dia_driver.R"), harness)
+    recipe <- readWorkflowCheckpointRecipe("small")
+    recipe$n_proteins <- 8L; recipe$n_samples <- 8L
+    recipe$peptides_per_protein <- 4L; recipe$forms_per_peptide <- 2L
+    object <- makeWorkflowCheckpointPeptide(recipe)
+    manager <- newDIAStateAdapter(newWorkflowEntityStore(withr::local_tempdir(),
+        "ownership-probe", "DIA"), WorkflowState$new(audit_enabled = FALSE))
+    withr::defer(closeDIAStateAdapter(manager))
+    manager$.context$reference_states <- TRUE
+    manager$saveState("input", object, list(), "fixture")
+    reference <- getDIAStateReference(manager)
+    record <- readDIAStateMetadata(manager, reference)
+    probe <- harness$probePerf107Materializations
+    complete <- function(result) {
+        expect_identical(result$status, "complete")
+        expect_null(getOption("multischolar.perf107_materialization_probe"))
+        expect_lt(as.numeric(object.size(result)), 65536)
+    }
+    whole <- function(result) any(vapply(result$events,
+        function(event) isTRUE(event$whole_current_assay), logical(1)))
+    metadata <- probe(manager, function() readDIAExecutionComponents(manager,
+        reference, fields = character()))
+    complete(metadata)
+    expect_false(whole(metadata))
+    actual <- NULL
+    direct <- probe(manager, function() {
+        actual <<- materializeDIATable(manager$.context, record$data$components$peptide_data)
+    })
+    complete(direct)
+    expect_true(whole(direct))
+    expect_identical(actual, object@peptide_data)
+    expect_identical(diaStateOwnership(manager)$full_s4_reads, 0L)
+    component <- probe(manager, function() readDIAExecutionComponents(manager,
+        reference, fields = "peptide_data"))
+    complete(component)
+    expect_true(whole(component))
+    explicit <- probe(manager, function() materializeDIATable(manager$.context,
+        record$data$components$peptide_data, selected_columns = names(object@peptide_data)))
+    complete(explicit)
+    expect_true(whole(explicit))
+    failed <- probe(manager, function() {
+        materializeDIATable(manager$.context, record$data$components$peptide_data)
+        stop("injected diagnostic failure")
+    })
+    expect_identical(failed$status, "failed")
+    expect_match(failed$failure$message, "injected diagnostic failure")
+    expect_true(whole(failed))
+    expect_null(getOption("multischolar.perf107_materialization_probe"))
+    for (name in c("materializeDIAStateRecord", "readDIAExecutionComponents", "materializeDIATable")) {
+        expect_false(methods::is(get(name, asNamespace("MultiScholaR")), "functionWithTrace"))
+    }
+    expect_identical(getDIAStateReference(manager), reference)
+    expect_identical(manager$.context$store$open_resources, 0L)
+})
+
+test_that("holder inventory inspects cached values without evaluating unknown getters", {
+    harness <- new.env(parent = baseenv())
+    sys.source(test_path("..", "..", "tools/profiling/workflow_checkpoint_dia_driver.R"), harness)
+    roots <- stats::setNames(rep(list(NULL), 8L), c("workflow", "design_initial",
+        "design_cleaned", "design_result", "history", "cache", "plot", "result"))
+    inspect <- function() harness$inspectPerf107Holders(roots, c("Run", "Quantity"))
+    assay <- data.frame(Run = c("a", "b"), Quantity = c(1, 2))
+    expect_identical(inspect()$status, "complete")
+    expect_error(harness$inspectPerf107Holders(roots[-1], c("Run", "Quantity")), "complete explicit")
+    roots$design_result <- shiny::reactiveVal(list(data_cln = assay))
+    expect_identical(inspect()$status, "failed")
+    expect_match(inspect()$retained_assays[[1L]]$path, "design_result/cached/data_cln")
+    roots$design_result <- NULL
+    evaluated <- 0L
+    roots$design_initial <- shiny::reactive({ evaluated <<- evaluated + 1L; list(data_cln = assay) })
+    expect_identical(inspect()$status, "inconclusive")
+    expect_identical(evaluated, 0L)
+    shiny::isolate(roots$design_initial())
+    expect_identical(inspect()$status, "failed")
+    expect_identical(evaluated, 1L)
+    roots$design_initial <- NULL
+    cache <- new.env(parent = emptyenv())
+    makeActiveBinding("payload", function(value) stop("must not call active getter"), cache)
+    delayedAssign("lazy_payload", stop("must not force promise"), assign.env = cache)
+    roots$cache <- cache
+    expect_identical(inspect()$status, "inconclusive")
+    expect_setequal(inspect()$uninspected, c("cache/lazy_payload", "cache/payload"))
+    roots$cache <- NULL
+    frame <- new.env(parent = baseenv()); frame$theObject <- list(peptide_data = assay)
+    roots$plot <- eval(quote(function() stop("must not render")), frame)
+    expect_identical(inspect()$status, "failed")
+    roots$plot <- NULL
+    roots$result <- structure(1, hidden_assay = assay)
+    expect_identical(inspect()$status, "failed")
+    roots$result <- NULL
+    cache <- new.env(parent = emptyenv()); cache$self <- cache
+    roots$cache <- cache
+    expect_identical(inspect()$status, "complete")
+    expect_lt(as.numeric(object.size(inspect())), 65536)
+})
