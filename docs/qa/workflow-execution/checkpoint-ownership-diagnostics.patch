+#' Observe explicit assay materialization in an untimed small ownership check.
+#' @param manager Reference-backed owner whose current assay is being checked.
+#' @param run Diagnostic callback; its return value is discarded, never recorded.
+#' @return Bounded events and terminal status, without scientific payloads.
+#' @noRd
+probePerf107Materializations <- function(manager, run) {
+    namespace <- asNamespace("MultiScholaR")
+    api <- function(name) get(name, namespace, inherits = FALSE)
+    if (!api("usesDIAReferenceStates")(manager) || !is.function(run))
+        stop("reference owner and diagnostic callback required")
+    source_reference <- api("getDIAStateReference")(manager)
+    record <- api("readDIAStateMetadata")(manager, source_reference)
+    assay <- record$data$components$peptide_data
+    columns <- record$data$dimensions$columns
+    if (!api("isSavedWorkflowReference")(assay) || !length(columns) ||
+        record$data$dimensions$rows > 2000L) stop("small peptide ownership fixture required")
+    functions <- c("materializeDIAStateRecord", "readDIAExecutionComponents", "materializeDIATable")
+    if (any(vapply(functions, function(name)
+        methods::is(api(name), "functionWithTrace"), logical(1))))
+        stop("ownership probe must not replace existing tracing")
+    option <- "multischolar.perf107_materialization_probe"
+    previous <- getOption(option)
+    if (!is.null(previous)) stop("ownership probe is already active")
+    events <- list()
+    hook <- function(kind, frame) {
+        context <- if (kind == "readDIAExecutionComponents")
+            get("manager", frame, inherits = FALSE)$.context else
+            get("context", frame, inherits = FALSE)
+        if (!identical(context, manager$.context)) return(invisible(NULL))
+        if (length(events) >= 256L) stop("ownership probe event ceiling exceeded")
+        reference <- get("reference", frame, inherits = FALSE)
+        selected <- if (kind == "materializeDIATable")
+            get("selected_columns", frame, inherits = FALSE) else NULL
+        whole_assay <- kind == "materializeDIATable" &&
+            identical(reference$entity_id, assay$entity_id) &&
+            is.null(get("relation", frame, inherits = FALSE)) &&
+            (is.null(selected) || setequal(selected, columns))
+        events[[length(events) + 1L]] <<- list(kind = kind,
+            reference_id = reference$entity_id, whole_current_assay = whole_assay,
+            selected_columns = selected,
+            fields = if (kind == "readDIAExecutionComponents")
+                get("fields", frame, inherits = FALSE) else NULL)
+        invisible(NULL)
+    }
+    options(stats::setNames(list(hook), option))
+    traced <- character()
+    on.exit({
+        for (name in rev(traced)) base::untrace(name, where = namespace)
+        options(stats::setNames(list(previous), option))
+    }, add = TRUE)
+    for (name in functions) {
+        tracer <- substitute(getOption(OPTION)(KIND, environment()),
+            list(OPTION = option, KIND = name))
+        base::trace(name, tracer = tracer, where = namespace, print = FALSE)
+        traced <- c(traced, name)
+    }
+    failure <- tryCatch({ run(); NULL }, error = function(error)
+        list(message = substr(conditionMessage(error), 1L, 512L), class = class(error)))
+    list(status = if (is.null(failure)) "complete" else "failed",
+        input_reference = source_reference$entity_id,
+        assay_reference = assay$entity_id, events = events, failure = failure,
+        scope = "untimed current-assay materialization; not a holder census or arbitrary-reader proof")
+}
