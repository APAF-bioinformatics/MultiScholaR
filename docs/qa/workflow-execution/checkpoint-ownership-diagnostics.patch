+#' Inspect declared small-fixture holders without evaluating reactive getters.
+#' @param holders Named live roots supplied explicitly by the owning modules.
+#' @param assay_columns Scientific columns identifying a retained assay table.
+#' @return Bounded paths and shapes; unknown bindings prevent a passing result.
+#' @noRd
+inspectPerf107Holders <- function(holders, assay_columns) {
+    required <- c("workflow", "design_initial", "design_cleaned", "design_result",
+        "history", "cache", "plot", "result")
+    if (!is.list(holders) || !identical(sort(names(holders)), sort(required)) ||
+        !is.character(assay_columns) || !length(assay_columns) || anyNA(assay_columns))
+        stop("complete explicit ownership roots and assay columns required")
+    findings <- list(); unknown <- character(); seen <- character(); nodes <- 0L
+    walk <- function(value, path, depth = 0L) {
+        nodes <<- nodes + 1L
+        if (nodes > 4096L || depth > 24L) stop("ownership inventory ceiling exceeded")
+        if (is.null(value)) return(invisible(NULL))
+        if (inherits(value, "reactiveVal")) {
+            implementation <- attr(value, ".impl", exact = TRUE)
+            if (!is.environment(implementation) || !is.environment(implementation$private) ||
+                !exists("value", implementation$private, inherits = FALSE)) {
+                unknown <<- c(unknown, path); return(invisible(NULL))
+            }
+            walk(implementation$private$value, paste0(path, "/cached"), depth + 1L)
+            return(invisible(NULL))
+        }
+        if (inherits(value, "reactive")) {
+            observable <- attr(value, "observable", exact = TRUE)
+            if (!is.environment(observable) || !exists(".value", observable, inherits = FALSE) ||
+                isTRUE(observable$.invalidated) || isTRUE(observable$.error)) {
+                unknown <<- c(unknown, path); return(invisible(NULL))
+            }
+            walk(observable$.value, paste0(path, "/cached"), depth + 1L)
+            return(invisible(NULL))
+        }
+        backing <- if (is.function(value)) attr(value, "dia_reference", exact = TRUE) else NULL
+        if (!is.null(backing)) {
+            walk(backing, paste0(path, "/reference_cache"), depth + 1L)
+            return(invisible(NULL))
+        }
+        if (is.data.frame(value)) {
+            if (nrow(value) && all(assay_columns %in% names(value)))
+                findings[[length(findings) + 1L]] <<- list(path = path,
+                    rows = nrow(value), columns = ncol(value))
+            for (field in names(value))
+                if (is.list(value[[field]])) walk(value[[field]], paste0(path, "/", field), depth + 1L)
+            extra <- attributes(value)[setdiff(names(attributes(value)), c("class", "names", "row.names"))]
+            if (length(extra)) walk(extra, paste0(path, "/attributes"), depth + 1L)
+            return(invisible(NULL))
+        }
+        if (is.function(value)) {
+            frame <- environment(value)
+            if (!is.null(frame)) walk(frame, paste0(path, "/closure"), depth + 1L)
+            return(invisible(NULL))
+        }
+        if (is.environment(value)) {
+            if (isNamespace(value) || identical(value, baseenv()) || identical(value, emptyenv()))
+                return(invisible(NULL))
+            if (identical(value, globalenv())) {
+                unknown <<- c(unknown, path); return(invisible(NULL))
+            }
+            address <- rlang::obj_address(value)
+            if (address %in% seen) return(invisible(NULL))
+            seen <<- c(seen, address)
+            fields <- ls(value, all.names = TRUE)
+            for (field in fields) {
+                next_path <- paste0(path, "/", field)
+                if (rlang::env_binding_are_active(value, field) ||
+                    rlang::env_binding_are_lazy(value, field)) {
+                    unknown <<- c(unknown, next_path)
+                } else walk(get(field, value, inherits = FALSE), next_path, depth + 1L)
+            }
+            if (!isNamespace(parent.env(value)) && !identical(parent.env(value), baseenv()) &&
+                !identical(parent.env(value), emptyenv()))
+                unknown <<- c(unknown, paste0(path, "/uninspected_parent"))
+            return(invisible(NULL))
+        }
+        if (isS4(value)) {
+            for (field in methods::slotNames(value))
+                walk(methods::slot(value, field), paste0(path, "/", field), depth + 1L)
+        } else if (is.list(value)) {
+            labels <- names(value)
+            for (i in seq_along(value)) walk(value[[i]], paste0(path, "/",
+                if (is.null(labels) || !nzchar(labels[[i]])) i else labels[[i]]), depth + 1L)
+        } else if (!is.atomic(value)) unknown <<- c(unknown, path)
+        extra <- attributes(value)[setdiff(names(attributes(value)),
+            c("class", "names", "row.names", "dim", "dimnames"))]
+        if (length(extra) && !isS4(value)) walk(extra, paste0(path, "/attributes"), depth + 1L)
+        invisible(NULL)
+    }
+    for (root in required) walk(holders[[root]], root)
+    list(status = if (length(findings)) "failed" else if (length(unknown)) "inconclusive" else "complete",
+        roots = required, retained_assays = findings, uninspected = unique(unknown), nodes = nodes,
+        scope = "declared roots and cached values only; no whole-heap or installed-wiring claim")
 }
 
