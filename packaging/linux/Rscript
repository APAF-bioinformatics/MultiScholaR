#!/bin/sh
# MultiScholaR bundle (KIT-134): the launcher for the bundled R on Linux, and the one definition of
# the environment R runs in. It finds the bundle from its own location, so the folder can sit
# anywhere, and it gives R nothing from the host but the C library and the core utilities.
# From the KIT-130 spike (tools/dist-spike/linux/Rscript on branch kit-130-dist-spike).
bundle="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd -P)"

# Nothing from the host steers R or Python to another installation, library or profile.
unset R_HOME R_LIBS R_ENVIRON R_ENVIRON_USER R_PROFILE R_PROFILE_USER \
    PYTHONPATH PYTHONHOME RETICULATE_PYTHON_ENV CONDA_PREFIX VIRTUAL_ENV

# Rscript execs $RHOME/bin/R; without RHOME it uses the build-time prefix compiled into it.
RHOME="$bundle/R"
# Neither folder exists: R then keeps only its own library on the search path, even if the user
# has a personal or site library.
R_LIBS_USER="$bundle/R/no-user-library"
R_LIBS_SITE="$bundle/R/no-site-library"
# The shared libraries R and the packages were linked against at build time.
LD_LIBRARY_PATH="$bundle/syslib"
RETICULATE_PYTHON="$bundle/python/bin/python3"
PYTHONNOUSERSITE=1
# rmarkdown finds pandoc here before it looks on the PATH.
RSTUDIO_PANDOC="$bundle/pandoc"
PATH=/usr/bin:/bin
MSR_BUNDLE="$bundle"
export RHOME R_LIBS_USER R_LIBS_SITE LD_LIBRARY_PATH RETICULATE_PYTHON PYTHONNOUSERSITE RSTUDIO_PANDOC \
    PATH MSR_BUNDLE

# R needs a UTF-8 locale for the application's text; C.UTF-8 is in every glibc from 2.35 on.
case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
    *UTF-8* | *utf8* | *UTF8* | *utf-8*) ;;
    *)
        unset LC_ALL
        LANG=C.UTF-8
        LC_CTYPE=C.UTF-8
        export LANG LC_CTYPE
        ;;
esac

exec "$bundle/R/bin/Rscript" "$@"
