+#' Open a Bounded Incremental Parquet Writer
+#'
+#' Experimental bridge to the existing native parallel writer. The destination
+#' must be fresh. The final file appears only after successful close; abort or
+#' finalization of an unfinished handle removes its private temporary file.
+#' @param prototype Empty data frame/list of columns, or a nanoarrow C stream.
+#' @param path Fresh output path.
+#' @param metadata Named list of scalar strings for the R-column mode.
+#' @param n_threads Encoder thread limit.
+#' @return An owned external pointer; finish with close_parquet_writer_fast().
+#' @export
+open_parquet_writer_fast <- function(prototype, path, metadata = list(), n_threads = 8L) {
+  if (inherits(prototype, "nanoarrow_array_stream")) {
+    return(open_incremental_arrow_rust(prototype, path, as.integer(n_threads)))
+  }
+  cols <- lapply(as.list(prototype), prepare_column)
+  if (any(lengths(cols) != 0L)) stop("prototype must have zero rows")
+  if (length(metadata) && (is.null(names(metadata)) || any(!nzchar(names(metadata))) ||
+      any(lengths(metadata) != 1L) || !all(vapply(metadata, is.character, logical(1))))) {
+    stop("metadata must be named scalar strings")
+  }
+  open_incremental_r_rust(cols, path, if (length(metadata)) names(metadata) else character(),
+    as.character(unlist(metadata, use.names = FALSE)), as.integer(n_threads))
+}
+
+#' Append a Bounded Batch to a Native Parquet Writer
+#' @param writer Owned incremental writer.
+#' @param data Data frame/list with at most 10000 rows, or a nanoarrow C stream.
+#' @param owner R owner retained until imported Arrow batches are encoded.
+#' @param logical_bytes Logical Arrow bytes, required for a C stream.
+#' @return Written/pending row counts and the current private output path.
+#' @export
+append_parquet_writer_fast <- function(writer, data, owner = NULL, logical_bytes = NULL) {
+  tryCatch({
+    if (inherits(data, "nanoarrow_array_stream")) {
+      if (is.null(logical_bytes)) stop("logical_bytes is required for Arrow input")
+      append_incremental_arrow_rust(writer, data, owner, as.numeric(logical_bytes))
+    } else {
+      cols <- lapply(as.list(data), prepare_column)
+      rows <- if (length(cols)) length(cols[[1L]]) else 0L
+      append_incremental_r_rust(writer, cols, as.integer(rows))
+    }
+  }, error = function(error) {
+    abort_incremental_rust(writer)
+    stop(error)
+  })
+}
+
+#' Flush Pending Rows in an Incremental Native Writer
+#' @param writer Owned incremental writer.
+#' @return Written/pending row counts and paths.
+#' @export
+flush_parquet_writer_fast <- function(writer) flush_incremental_rust(writer)
+
+#' Finish an Incremental Native Writer
+#' @param writer Owned incremental writer.
+#' @return Final row count and closed state after atomic file publication.
+#' @export
+close_parquet_writer_fast <- function(writer) close_incremental_rust(writer)
+
+#' Abort an Incremental Native Writer
+#' @param writer Owned incremental writer.
+#' @return Closed state after releasing buffers and removing the private file.
+#' @export
+abort_parquet_writer_fast <- function(writer) abort_incremental_rust(writer)
