+/// Build one bounded R batch with the existing converters; the returned arrays borrow
+/// numeric R memory. The caller must retain `df` until every array is dropped.
+pub(crate) fn bounded_record_batch(df: &List, rows: usize, local_tz: &str) -> Result<arrow_array::RecordBatch> {
+    let names: Vec<String> = df.names().ok_or_else(|| Error::Other("Columns must be named".into()))?
+        .map(|n| n.to_string()).collect();
+    let columns: Vec<Robj> = df.values().collect();
+    if columns.iter().any(|c| c.len() != rows) {
+        return Err(Error::Other("Column lengths differ".into()));
+    }
+    let described = names.iter().zip(&columns).map(|(n,c)| describe_column(n,c,local_tz))
+        .collect::<Result<Vec<_>>>()?;
+    let fields = described.iter().map(|(f,_)| f.clone()).collect();
+    let arrays = described.iter().zip(&names).map(|((_,source), name)|
+        build_chunk(source, name, 0, rows).map_err(Error::Other)).collect::<Result<Vec<_>>>()?;
+    // `df` remains protected by the incremental writer's R guard, not this local vector.
+    fast_duckdb_engine::writer::build_record_batch(fields, arrays, rows).map_err(Error::Other)
+}
