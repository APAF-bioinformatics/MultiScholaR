+#' Inspect the bounded incremental writer capability contract
+#' @return API, platform, limits and source-bound installation manifest.
+#' @export
+parquet_writer_capabilities <- function() {
+  path <- system.file("incremental-manifest.rds", package = "fastduckdb")
+  if (!nzchar(path)) stop("incremental writer build manifest is missing")
+  readRDS(path)
+}
+
+# Validate this new interface without narrowing legacy write_parquet_fast().
+validate_incremental_columns <- function(data) {
+  if (!is.list(data) || !length(data) || is.null(names(data)) ||
+      anyNA(names(data)) || any(!nzchar(names(data))) || anyDuplicated(names(data)))
+    stop("incremental columns require unique nonempty names")
+  if (length(unique(lengths(data))) != 1L || lengths(data)[[1L]] > 10000L)
+    stop("incremental input requires equal lengths and at most 10000 rows")
+  bytes <- vapply(data, function(x) {
+    cls <- attr(x, "class")
+    factor_ok <- is.factor(x) && (identical(cls, "factor") || identical(cls, c("ordered", "factor")))
+    if (!is.null(dim(x)) || (!is.null(cls) && !factor_ok) ||
+        !typeof(x) %in% c("double", "integer", "logical", "character"))
+      stop("unsupported incremental column type")
+    # Count expanded UTF-8 bytes, including repeats, before native conversion.
+    text <- if (factor_ok) levels(x) else if (is.character(x)) x else character()
+    8 * (length(x) + 1) + sum(nchar(enc2utf8(text), type = "bytes", allowNA = TRUE), na.rm = TRUE)
+  }, numeric(1))
+  if (sum(bytes) > 67108864) stop("expanded incremental batch exceeds 64 MiB")
+  invisible(NULL)
+}
+
+#' Open a Bounded Incremental Parquet Writer
+#'
+#' Qualified R-column bridge to the existing native parallel writer. The destination
+#' must be fresh. The final file appears only after successful close; abort or
+#' finalization of an unfinished handle removes its private temporary file.
+#' @param prototype Empty data frame/list of columns, (Arrow streams are unsupported).
+#' @param path Fresh output path.
+#' @param metadata Named list of scalar strings for the R-column mode.
+#' @param n_threads Encoder thread limit.
+#' @return An owned external pointer; finish with close_parquet_writer_fast().
+#' @export
+open_parquet_writer_fast <- function(prototype, path, metadata = list(), n_threads = 8L) {
+  if (length(n_threads) != 1L || is.na(n_threads) || !is.finite(n_threads) ||
+      n_threads < 1L || n_threads > 8L || n_threads != floor(n_threads))
+    stop("incremental writer requires one to eight encoder threads")
+  if (inherits(prototype, "nanoarrow_array_stream")) {
+    stop("Arrow streams are outside the qualified incremental writer domain")
+  }
+  validate_incremental_columns(prototype)
+  cols <- lapply(as.list(prototype), prepare_column)
+  if (any(lengths(cols) != 0L)) stop("prototype must have zero rows")
+  if (length(metadata) && (is.null(names(metadata)) || any(!nzchar(names(metadata))) ||
+      any(lengths(metadata) != 1L) || !all(vapply(metadata, is.character, logical(1))))) {
+    stop("metadata must be named scalar strings")
+  }
+  open_incremental_r_rust(cols, path, if (length(metadata)) names(metadata) else character(),
+    as.character(unlist(metadata, use.names = FALSE)), as.integer(n_threads))
+}
+
+#' Append a Bounded Batch to a Native Parquet Writer
+#' @param writer Owned incremental writer.
+#' @param data Data frame/list with at most 10000 rows, (Arrow streams are unsupported).
+#' @param owner R owner retained until imported Arrow batches are encoded.
+#' @param logical_bytes Logical Arrow bytes, required for a C stream.
+#' @return Written/pending row counts and the current private output path.
+#' @export
+append_parquet_writer_fast <- function(writer, data, owner = NULL, logical_bytes = NULL) {
+  tryCatch({
+    if (inherits(data, "nanoarrow_array_stream")) {
+      stop("Arrow streams are outside the qualified incremental writer domain")
+    } else {
+      validate_incremental_columns(data)
+      cols <- lapply(as.list(data), prepare_column)
+      rows <- if (length(cols)) length(cols[[1L]]) else 0L
+      append_incremental_r_rust(writer, cols, as.integer(rows))
+    }
+  }, error = function(error) {
+    abort_incremental_rust(writer)
+    stop(error)
+  })
+}
+
+#' Flush Pending Rows in an Incremental Native Writer
+#' @param writer Owned incremental writer.
+#' @return Written/pending row counts and paths.
+#' @export
+flush_parquet_writer_fast <- function(writer) {
+  tryCatch(flush_incremental_rust(writer), error = function(error) {
+    abort_incremental_rust(writer)
+    stop(error)
+  })
+}
+
+#' Finish an Incremental Native Writer
+#' @param writer Owned incremental writer.
+#' @return Final row count and closed state after atomic file publication.
+#' @export
+close_parquet_writer_fast <- function(writer) {
+  tryCatch(close_incremental_rust(writer), error = function(error) {
+    abort_incremental_rust(writer)
+    stop(error)
+  })
+}
+
+#' Abort an Incremental Native Writer
+#' @param writer Owned incremental writer.
+#' @return Closed state after releasing buffers and removing the private file.
+#' @export
+abort_parquet_writer_fast <- function(writer) abort_incremental_rust(writer)
