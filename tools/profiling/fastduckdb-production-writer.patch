+//! Experimental R bridge to the existing incremental native writer.
+//! All R owners and C stream callbacks stay on the R thread. Encoding workers
+//! receive only owned/borrowed Arrow arrays while their owners remain protected.
+use std::collections::HashMap;
+use std::path::Path;
+use std::sync::Arc;
+use arrow_array::{Array, ArrayRef, RecordBatch, RecordBatchReader};
+use arrow_array::ffi_stream::{ArrowArrayStreamReader, FFI_ArrowArrayStream};
+use arrow_schema::{Schema, SchemaRef};
+use extendr_api::prelude::*;
+use fast_duckdb_engine::writer::{ParallelParquetWriter, ParallelWriteOptions};
+use crate::{Result, err};
+
+const MAX_BATCH_ROWS: usize = 10000;
+const MAX_GROUP_ROWS: usize = 122880;
+const MAX_GROUP_BYTES: usize = 33554432;
+
+pub struct IncrementalWriter {
+    engine: Option<ParallelParquetWriter>,
+    schema: SchemaRef,
+    batches: Vec<RecordBatch>,
+    // Drop arrays before their R owners. Never send these guards to workers.
+    guards: Vec<Robj>,
+    pending_rows: usize,
+    pending_bytes: usize,
+    written: usize,
+    threads: usize,
+    path: String,
+    temporary: String,
+}
+
+fn import_stream(stream: &Robj) -> Result<ArrowArrayStreamReader> {
+    if !stream.inherits("nanoarrow_array_stream") || stream.rtype() != Rtype::ExternalPtr {
+        return Err(Error::Other("Expected a nanoarrow_array_stream".into()));
+    }
+    let ptr = unsafe { extendr_ffi::R_ExternalPtrAddr(stream.get()) } as *mut FFI_ArrowArrayStream;
+    if ptr.is_null() { return Err(Error::Other("Released Arrow stream".into())); }
+    // The C Stream contract transfers its release callback and empties the producer.
+    unsafe { ArrowArrayStreamReader::from_raw(ptr) }.map_err(err("Arrow stream import"))
+}
+
+impl IncrementalWriter {
+    fn new(schema: SchemaRef, path: &str, threads: usize) -> Result<Self> {
+        if Path::new(path).exists() { return Err(Error::Other("Writer destination exists".into())); }
+        let opts = ParallelWriteOptions { n_threads: threads, row_group_size: MAX_GROUP_ROWS,
+            ..Default::default() };
+        let engine = ParallelParquetWriter::create(path, schema.clone(), "snappy", &opts)
+            .map_err(err("Incremental writer"))?;
+        let temporary = engine.temporary_path().to_string_lossy().into_owned();
+        Ok(Self { engine: Some(engine), schema, batches: Vec::new(), guards: Vec::new(),
+            pending_rows: 0, pending_bytes: 0, written: 0, threads, path: path.into(), temporary })
+    }
+    fn append(&mut self, batch: RecordBatch, guard: Robj, bytes: usize) -> Result<()> {
+        if self.engine.is_none() { return Err(Error::Other("Writer is closed".into())); }
+        if batch.num_rows() > MAX_BATCH_ROWS || batch.schema().fields() != self.schema.fields() {
+            return Err(Error::Other("Writer batch/schema differs".into()));
+        }
+        if batch.num_rows() == 0 { return Ok(()); }
+        if self.pending_rows > 0 && (self.pending_rows + batch.num_rows() > MAX_GROUP_ROWS ||
+            self.pending_bytes + bytes > MAX_GROUP_BYTES) { self.flush()?; }
+        self.pending_rows += batch.num_rows();
+        self.pending_bytes += bytes;
+        self.batches.push(batch);
+        self.guards.push(guard);
+        if self.pending_bytes >= MAX_GROUP_BYTES { self.flush()?; }
+        Ok(())
+    }
+    fn flush(&mut self) -> Result<()> {
+        let engine = self.engine.as_mut().ok_or_else(|| Error::Other("Writer is closed".into()))?;
+        if self.pending_rows == 0 { return Ok(()); }
+        let batches = &self.batches;
+        let make = |_group: usize, col: usize, start: usize, len: usize| -> std::result::Result<ArrayRef,String> {
+            let mut offset = 0;
+            let mut pieces = Vec::new();
+            for batch in batches {
+                let lo = start.max(offset);
+                let hi = (start + len).min(offset + batch.num_rows());
+                if lo < hi { pieces.push(batch.column(col).slice(lo-offset, hi-lo)); }
+                offset += batch.num_rows();
+            }
+            if pieces.len() == 1 { return Ok(pieces.remove(0)); }
+            let refs: Vec<&dyn Array> = pieces.iter().map(|a| a.as_ref()).collect();
+            arrow::compute::concat(&refs).map_err(|e| e.to_string())
+        };
+        engine.write_row_groups(&[self.pending_rows], self.threads, &make).map_err(err("Incremental append"))?;
+        self.written += self.pending_rows;
+        self.batches.clear();
+        self.guards.clear();
+        self.pending_rows = 0;
+        self.pending_bytes = 0;
+        Ok(())
+    }
+    fn info(&self) -> Robj {
+        list!(written_rows=self.written as f64, pending_rows=self.pending_rows as f64,
+            pending_bytes=self.pending_bytes as f64, temporary_path=self.temporary.clone(),
+            path=self.path.clone(), closed=self.engine.is_none()).into_robj()
+    }
+    fn abort(&mut self) {
+        self.engine.take();
+        self.batches.clear();
+        self.guards.clear();
+        self.pending_rows=0;
+        self.pending_bytes=0;
+    }
+}
+
+/// @keywords internal
+#[extendr]
+fn open_incremental_arrow_rust(stream: Robj, path: &str, n_threads: i32) -> Result<ExternalPtr<IncrementalWriter>> {
+    let reader=import_stream(&stream)?;
+    Ok(ExternalPtr::new(IncrementalWriter::new(reader.schema(), path, n_threads.max(1) as usize)?))
+}
+/// @keywords internal
+#[extendr]
+fn open_incremental_r_rust(df: List, path: &str, keys: Vec<String>, values: Vec<String>, n_threads: i32) -> Result<ExternalPtr<IncrementalWriter>> {
+    if keys.len()!=values.len() { return Err(Error::Other("Metadata differs".into())); }
+    let batch=crate::write::bounded_record_batch(&df,0,"UTC")?;
+    let metadata: HashMap<String,String>=keys.into_iter().zip(values).collect();
+    let schema=Arc::new(Schema::new_with_metadata(batch.schema().fields().clone(),metadata));
+    Ok(ExternalPtr::new(IncrementalWriter::new(schema,path,n_threads.max(1) as usize)?))
+}
+/// @keywords internal
+#[extendr]
+fn append_incremental_arrow_rust(mut writer: ExternalPtr<IncrementalWriter>, stream: Robj, owner: Robj, logical_bytes: f64) -> Result<Robj> {
+    let mut reader=import_stream(&stream)?;
+    if reader.schema().as_ref()!=writer.schema.as_ref() { return Err(Error::Other("Writer stream schema differs".into())); }
+    let mut batches=Vec::new();
+    let mut rows=0usize;
+    for batch in &mut reader {
+        let batch=batch.map_err(err("Arrow stream batch"))?;
+        rows+=batch.num_rows();
+        if rows>MAX_BATCH_ROWS { return Err(Error::Other("Arrow input exceeds 10000 rows".into())); }
+        batches.push(batch);
+    }
+    if !logical_bytes.is_finite() || logical_bytes<0.0 || logical_bytes>67108864.0 {
+        return Err(Error::Other("Invalid bounded Arrow byte count".into()));
+    }
+    let count=batches.len();
+    for batch in batches { writer.append(batch, owner.clone(), (logical_bytes as usize).div_ceil(count.max(1)))?; }
+    Ok(writer.info())
+}
+/// @keywords internal
+#[extendr]
+fn append_incremental_r_rust(mut writer: ExternalPtr<IncrementalWriter>, df: List, rows: i32) -> Result<Robj> {
+    if rows<0 || rows as usize>MAX_BATCH_ROWS { return Err(Error::Other("R input exceeds 10000 rows".into())); }
+    let batch=crate::write::bounded_record_batch(&df,rows as usize,"UTC")?;
+    let bytes=batch.get_array_memory_size();
+    writer.append(batch, df.into_robj(), bytes)?;
+    Ok(writer.info())
