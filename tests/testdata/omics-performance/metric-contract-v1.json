{
  "schema": "multischolar.omics_publication_metric_contract",
  "schema_version": "1.0.0",
  "metric_contract_id": "multischolar.omics_publication_metric_contract.2026-08-27.v1",
  "owner_ticket_id": "OMICS-ART-063",
  "measurement_schema": "multischolar.omics_publication_cgroup_measurement/1.0.0",
  "authoritative_references": [
    "https://www.kernel.org/doc/html/latest/admin-guide/cgroup-v2.html",
    "https://www.kernel.org/doc/html/latest/filesystems/proc.html",
    "https://www.kernel.org/doc/html/latest/accounting/psi.html"
  ],
  "rules": {
    "absent_is_zero": false,
    "nonfinite_primary_metric_is_valid": false,
    "measurement_overhead_subtracted": false,
    "memory_stat_slab_is_subset_of_kernel": true,
    "memory_accounted_sum": "anon + file + kernel",
    "rss_pss_uss_are_process_tree_crosschecks_not_cgroup_charged_memory": true,
    "uss_derivation": "Private_Clean + Private_Dirty + Private_Hugetlb from smaps_rollup",
    "retained_estimate": "median of samples inside the final two seconds of a five-second zero-work window; raw samples must bracket both exact window boundaries and the worker blocks on fifo_v1 until the stop boundary is sampled",
    "retention_acknowledgement": "fifo_v1",
    "maximum_boundary_bracket_seconds": 0.5,
    "query_resampling_unit": "fresh_process_run_pair"
  },
  "metrics": [
    {"metric_id": "peak_charged_memory_bytes", "unit": "bytes", "source": "cgroup_v2/memory.peak", "aggregation": "lifetime_high_water", "phase": "worker_lifecycle", "role": "primary"},
    {"metric_id": "peak_sampled_charged_memory_bytes", "unit": "bytes", "source": "cgroup_v2/memory.current", "aggregation": "sample_maximum", "phase": "worker_lifecycle", "role": "diagnostic"},
    {"metric_id": "retained_charged_memory_bytes", "unit": "bytes", "source": "cgroup_v2/memory.current", "aggregation": "retained_window_median", "phase": "settled_dwell", "role": "primary"},
    {"metric_id": "peak_anonymous_memory_bytes", "unit": "bytes", "source": "cgroup_v2/memory.stat:anon", "aggregation": "sample_maximum", "phase": "worker_lifecycle", "role": "primary"},
    {"metric_id": "retained_anonymous_memory_bytes", "unit": "bytes", "source": "cgroup_v2/memory.stat:anon", "aggregation": "retained_window_median", "phase": "settled_dwell", "role": "primary"},
    {"metric_id": "peak_file_memory_bytes", "unit": "bytes", "source": "cgroup_v2/memory.stat:file", "aggregation": "sample_maximum", "phase": "worker_lifecycle", "role": "secondary"},
    {"metric_id": "retained_file_memory_bytes", "unit": "bytes", "source": "cgroup_v2/memory.stat:file", "aggregation": "retained_window_median", "phase": "settled_dwell", "role": "secondary"},
    {"metric_id": "peak_kernel_memory_bytes", "unit": "bytes", "source": "cgroup_v2/memory.stat:kernel", "aggregation": "sample_maximum", "phase": "worker_lifecycle", "role": "secondary"},
    {"metric_id": "retained_kernel_memory_bytes", "unit": "bytes", "source": "cgroup_v2/memory.stat:kernel", "aggregation": "retained_window_median", "phase": "settled_dwell", "role": "secondary"},
    {"metric_id": "peak_slab_memory_bytes", "unit": "bytes", "source": "cgroup_v2/memory.stat:slab", "aggregation": "sample_maximum", "phase": "worker_lifecycle", "role": "diagnostic"},
    {"metric_id": "retained_slab_memory_bytes", "unit": "bytes", "source": "cgroup_v2/memory.stat:slab", "aggregation": "retained_window_median", "phase": "settled_dwell", "role": "diagnostic"},
    {"metric_id": "peak_swap_bytes", "unit": "bytes", "source": "cgroup_v2/memory.swap.current", "aggregation": "sample_maximum", "phase": "worker_lifecycle", "role": "validity_gate"},
    {"metric_id": "peak_pss_bytes", "unit": "bytes", "source": "proc_pid_smaps_rollup:Pss", "aggregation": "process_tree_sum_then_sample_maximum", "phase": "worker_lifecycle", "role": "crosscheck"},
    {"metric_id": "retained_pss_bytes", "unit": "bytes", "source": "proc_pid_smaps_rollup:Pss", "aggregation": "process_tree_sum_then_retained_window_median", "phase": "settled_dwell", "role": "crosscheck"},
    {"metric_id": "peak_uss_bytes", "unit": "bytes", "source": "derived_proc_pid_smaps_rollup_private_fields", "aggregation": "process_tree_sum_then_sample_maximum", "phase": "worker_lifecycle", "role": "crosscheck"},
    {"metric_id": "retained_uss_bytes", "unit": "bytes", "source": "derived_proc_pid_smaps_rollup_private_fields", "aggregation": "process_tree_sum_then_retained_window_median", "phase": "settled_dwell", "role": "crosscheck"},
    {"metric_id": "peak_rss_bytes", "unit": "bytes", "source": "proc_pid_smaps_rollup:Rss", "aggregation": "process_tree_sum_then_sample_maximum", "phase": "worker_lifecycle", "role": "compatibility_crosscheck"},
    {"metric_id": "retained_rss_bytes", "unit": "bytes", "source": "proc_pid_smaps_rollup:Rss", "aggregation": "process_tree_sum_then_retained_window_median", "phase": "settled_dwell", "role": "compatibility_crosscheck"},
    {"metric_id": "peak_reconciliation_absolute_residual_bytes", "unit": "bytes", "source": "derived_memory.current_minus_anon_file_kernel", "aggregation": "sample_maximum_absolute_difference", "phase": "worker_lifecycle", "role": "accounting_diagnostic"},
    {"metric_id": "retained_reconciliation_absolute_residual_bytes", "unit": "bytes", "source": "derived_memory.current_minus_anon_file_kernel", "aggregation": "retained_window_median_absolute_difference", "phase": "settled_dwell", "role": "accounting_diagnostic"},
    {"metric_id": "elapsed_seconds", "unit": "seconds", "source": "worker_monotonic_phase_clock", "aggregation": "stop_minus_start", "phase": "declared_estimand", "role": "primary"},
    {"metric_id": "phase_cpu_seconds", "unit": "seconds", "source": "cgroup_v2/cpu.stat:usage_usec", "aggregation": "stop_counter_minus_start_counter", "phase": "declared_estimand", "role": "primary"},
    {"metric_id": "phase_process_self_cpu_seconds", "unit": "seconds", "source": "R_proc.time_user.self_plus_sys.self", "aggregation": "stop_minus_start", "phase": "declared_estimand", "role": "diagnostic"},
    {"metric_id": "cpu_usage_seconds", "unit": "seconds", "source": "cgroup_v2/cpu.stat:usage_usec", "aggregation": "lifecycle_counter_maximum", "phase": "worker_lifecycle", "role": "secondary"},
    {"metric_id": "cpu_user_seconds", "unit": "seconds", "source": "cgroup_v2/cpu.stat:user_usec", "aggregation": "lifecycle_counter_maximum", "phase": "worker_lifecycle", "role": "secondary"},
    {"metric_id": "cpu_system_seconds", "unit": "seconds", "source": "cgroup_v2/cpu.stat:system_usec", "aggregation": "lifecycle_counter_maximum", "phase": "worker_lifecycle", "role": "secondary"},
    {"metric_id": "primary_work_units_per_wall_second", "unit": "declared_work_units_per_second", "source": "worker_work_count_divided_by_elapsed_seconds", "aggregation": "ratio", "phase": "declared_estimand", "role": "primary"},
    {"metric_id": "primary_work_units_per_cpu_second", "unit": "declared_work_units_per_cpu_second", "source": "worker_work_count_divided_by_phase_cpu_seconds", "aggregation": "ratio", "phase": "declared_estimand", "role": "primary"},
    {"metric_id": "io", "unit": "bytes_and_operations", "source": "cgroup_v2/io.stat", "aggregation": "lifecycle_counter_maximum_by_key", "phase": "worker_lifecycle", "role": "secondary"},
    {"metric_id": "phase_io", "unit": "bytes_and_operations", "source": "cgroup_v2/io.stat", "aggregation": "stop_counter_minus_start_counter_by_key", "phase": "declared_estimand", "role": "secondary"},
    {"metric_id": "pressure_total_usec", "unit": "microseconds", "source": "cgroup_v2/*_pressure:some_or_full_total", "aggregation": "lifecycle_counter_maximum", "phase": "worker_lifecycle", "role": "diagnostic_optional"},
    {"metric_id": "peak_logical_disk_bytes", "unit": "bytes", "source": "run_directory_file_sizes", "aggregation": "sample_maximum", "phase": "worker_lifecycle", "role": "secondary"},
    {"metric_id": "peak_allocated_disk_bytes", "unit": "bytes", "source": "du_-s_-B1_run_directory", "aggregation": "sample_maximum", "phase": "worker_lifecycle", "role": "secondary"},
    {"metric_id": "peak_disk_category_logical_bytes", "unit": "bytes", "source": "run_directory_category_file_sizes", "aggregation": "sample_maximum_by_exclusive_category", "phase": "worker_lifecycle", "role": "secondary"},
    {"metric_id": "final_logical_disk_bytes", "unit": "bytes", "source": "run_directory_file_sizes", "aggregation": "post_worker_snapshot", "phase": "terminal", "role": "secondary"},
    {"metric_id": "final_allocated_disk_bytes", "unit": "bytes", "source": "du_-s_-B1_run_directory", "aggregation": "post_worker_snapshot", "phase": "terminal", "role": "secondary"},
    {"metric_id": "final_file_count", "unit": "files", "source": "run_directory_recursive_listing", "aggregation": "post_worker_count", "phase": "terminal", "role": "secondary"},
    {"metric_id": "peak_file_descriptors", "unit": "descriptors", "source": "proc_pid_fd", "aggregation": "process_tree_sum_then_sample_maximum", "phase": "worker_lifecycle", "role": "lifecycle"},
    {"metric_id": "retained_file_descriptors", "unit": "descriptors", "source": "proc_pid_fd", "aggregation": "process_tree_sum_then_retained_window_median", "phase": "settled_dwell", "role": "lifecycle"},
    {"metric_id": "peak_thread_tasks", "unit": "tasks", "source": "proc_pid_task", "aggregation": "process_tree_sum_then_sample_maximum", "phase": "worker_lifecycle", "role": "lifecycle"},
    {"metric_id": "retained_thread_tasks", "unit": "tasks", "source": "proc_pid_task", "aggregation": "process_tree_sum_then_retained_window_median", "phase": "settled_dwell", "role": "lifecycle"},
    {"metric_id": "peak_kernel_locks", "unit": "locks", "source": "proc_locks_pid_match", "aggregation": "sample_maximum", "phase": "worker_lifecycle", "role": "lifecycle"},
    {"metric_id": "retained_kernel_locks", "unit": "locks", "source": "proc_locks_pid_match", "aggregation": "retained_window_median", "phase": "settled_dwell", "role": "lifecycle"},
    {"metric_id": "maximum_process_count", "unit": "processes", "source": "cgroup.procs", "aggregation": "sample_maximum", "phase": "worker_lifecycle", "role": "lifecycle"},
    {"metric_id": "charged_memory_slope_bytes_per_second", "unit": "bytes_per_second", "source": "ordinary_least_squares_over_complete_retained_trace", "aggregation": "slope", "phase": "settled_dwell", "role": "settlement_diagnostic"},
    {"metric_id": "anonymous_memory_slope_bytes_per_second", "unit": "bytes_per_second", "source": "ordinary_least_squares_over_complete_retained_trace", "aggregation": "slope", "phase": "settled_dwell", "role": "settlement_diagnostic"},
    {"metric_id": "query_p50_seconds", "unit": "seconds", "source": "bounded_query_worker_monotonic_latency", "aggregation": "type_8_quantile_within_run", "phase": "bounded_query", "role": "secondary"},
    {"metric_id": "query_p95_seconds", "unit": "seconds", "source": "bounded_query_worker_monotonic_latency", "aggregation": "type_8_quantile_within_run", "phase": "bounded_query", "role": "secondary"},
    {"metric_id": "query_p99_seconds", "unit": "seconds", "source": "bounded_query_worker_monotonic_latency", "aggregation": "type_8_quantile_within_run", "phase": "bounded_query", "role": "secondary"},
    {"metric_id": "query_throughput_per_second", "unit": "queries_per_second", "source": "measured_query_count_divided_by_monotonic_query_suite_elapsed", "aggregation": "within_run_ratio", "phase": "bounded_query", "role": "secondary"},
    {"metric_id": "arrow_pool_bytes", "unit": "bytes", "source": "Arrow_memory_pool", "aggregation": "worker_reported_high_water_and_retained", "phase": "worker_lifecycle_and_settled_dwell", "role": "lifecycle_optional"},
    {"metric_id": "duckdb_resources", "unit": "bytes_and_counts", "source": "DuckDB_worker_resource_ledger", "aggregation": "worker_reported_high_water_and_terminal_zero_state", "phase": "worker_lifecycle_and_terminal", "role": "lifecycle_optional"}
  ]
}
