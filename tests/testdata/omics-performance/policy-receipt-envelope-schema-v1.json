{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apaf-bioinformatics.github.io/MultiScholaR/schemas/omics-auto-policy-receipt-envelope-v1.json",
  "title": "MultiScholaR Omics Auto Policy Receipt Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "envelope_id",
    "owner_ticket_id",
    "generated_from",
    "receipt_schema",
    "consumer_contract_digest",
    "receipts",
    "generation_contract",
    "envelope_digest"
  ],
  "properties": {
    "schema": {
      "const": "multischolar.omics_auto_policy_receipt_envelope"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "envelope_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_ticket_id": {
      "const": "OMICS-ART-069"
    },
    "generated_from": {
      "$ref": "#/$defs/binding"
    },
    "receipt_schema": {
      "$ref": "#/$defs/binding"
    },
    "consumer_contract_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "generation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generator_path",
        "generator_sha256",
        "copied_values_allowed",
        "additive_schema_successor",
        "production_defaults_changed"
      ],
      "properties": {
        "generator_path": {
          "type": "string",
          "minLength": 1
        },
        "generator_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "copied_values_allowed": {
          "const": false
        },
        "additive_schema_successor": {
          "const": true
        },
        "production_defaults_changed": {
          "const": false
        }
      }
    },
    "envelope_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "path_or_uri",
        "sha256"
      ],
      "properties": {
        "binding_id": {
          "type": "string",
          "minLength": 1
        },
        "path_or_uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
